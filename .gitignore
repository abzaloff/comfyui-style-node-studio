# Runtime style library. Keep only the bundled base preset file in Git.
/styles/*
!/styles/fooocus_styles.json

# User-specific favorites.
/favorites.json

# Python caches and test artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration.
.venv/
venv/
env/
.env
.env.*
!.env.example

# JavaScript dependencies and logs.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor settings.
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system files.
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files and logs.
*.tmp
*.temp
*.log
